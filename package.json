{
    "name": "update-node-hook-action",
    "version": "2.1.0",
    "private": true,
    "description": "Action to automatically update node-based pre-commit hooks.",
    "main": "dist/index.js",
    "scripts": {
        "typecheck": "tsc",
        "package": "esbuild src/main.ts --bundle --platform=node --target=node24 --minify --sourcemap --outfile=dist/index.js"
    },
    "author": "Paul Fischer <paul.fischer@mailbox.org>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/paulhfischer/update-node-hook-action.git"
    },
    "license": "GPL-3.0",
    "prettier": "@paulhfischer/prettier-config",
    "dependencies": {
        "@actions/core": "^3.0.1",
        "@actions/exec": "^3.0.0",
        "js-yaml": "^4.1.0",
        "simple-git": "^3.27.0"
    },
    "devDependencies": {
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^24.19.1",
        "esbuild": "^0.28.2",
        "typescript": "^6.0.3"
    }
}
